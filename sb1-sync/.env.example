# --- Fra developer.sparebank1.no (din registrerte klient) ---
SB1_CLIENT_ID=din_client_id_her
SB1_CLIENT_SECRET=din_client_secret_her

# --- Engangs-bootstrap ---
# Lim inn refresh_token fra BankID-innloggingen (det du fikk i PowerShell).
# Brukes KUN hvis data/token.json ikke finnes. Etter første kjøring er den
# roterte token-en i data/token.json fasit, og denne kan stå tom.
SB1_REFRESH_TOKEN=din_refresh_token_her

# --- Lagring ---
# VIKTIG: refresh-token roterer for hver fornying og må overleve restart.
# I Docker peker denne på et montert volum (se docker-compose.yml).
SB1_TOKEN_STORE=./data/token.json
SB1_OUT_DIR=./data

# Hvor mange dager bakover hver synk henter (overlapp tåles av dedup senere)
SB1_LOOKBACK_DAYS=90

# Bruk /transactions/classified for bankens kategorier.
# Default false (det enkle endepunktet er validert; classified må verifiseres).
SB1_USE_CLASSIFIED=false

# Cron for container-modus (Europe/Oslo). Tomt = kjør én gang og avslutt.
# Daglig kl 06:00:  0 6 * * *
SB1_SCHEDULE=

# --- Utdata (sink) ---
# 'file' (default), 'firestore', eller 'both'
SB1_SINK=file
# Sti til Firebase service account-nøkkel (kreves for firestore-sink).
# I Docker: monteres på /app/data via volumet.
GOOGLE_APPLICATION_CREDENTIALS=/app/data/sa-key.json
# Mellomlagrings-collection i Firestore
SB1_FIRESTORE_COLLECTION=sb1Transactions
