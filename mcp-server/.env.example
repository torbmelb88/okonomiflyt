# Hemmelig token som må inngå i connector-URL-en (eller sendes som header).
# Generer med: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_SECRET=change-me

# Egen nøkkel for Home Assistant-endepunktet (`ha`), sendes som x-api-key-header.
# Generer på samme måte som MCP_SECRET.
HA_SECRET=change-me
