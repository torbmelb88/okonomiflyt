rules_version = '2';

// Kopier denne fila til firestore.rules og fyll inn dine egne bruker-ID-er
// (Firebase Console -> Authentication -> Users). Deploy med:
//   firebase deploy --only firestore:rules
//
// Kun kjente brukere slipper til: web-appens Google-bruker og
// companion-appens dedikerte enhetskonto. sb1-sync bruker Admin SDK
// (service account) og går utenom reglene.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.uid in [
          'DIN_WEB_BRUKER_UID',       // web (Google-innlogging)
          'DIN_ENHETSKONTO_UID'       // companion-app (enhetskonto)
        ];
    }

    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
