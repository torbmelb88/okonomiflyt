{
    "firestore": {
        "rules": "firestore.rules"
    },
    "functions": [
        {
            "source": "mcp-server",
            "codebase": "mcp"
        }
    ],
    "hosting": {
        "public": "dist",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    }
}