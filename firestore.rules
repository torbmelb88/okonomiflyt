rules_version = '2';

// Kun kjente brukere slipper til: web-appens Google-bruker og
// companion-appens dedikerte enhetskonto. sb1-sync bruker Admin SDK
// (service account) og går utenom reglene.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.uid in [
          '5u0d0iQJnmdzs8av8aLgoaxPtul2', // web (Google-innlogging)
          'V3IW9zAL2EZgZatUdAtYDxIAriN2'  // companion-app (enhetskonto)
        ];
    }

    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
